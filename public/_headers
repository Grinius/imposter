# Response headers for the static site, applied by Cloudflare Workers Static Assets. API responses
# from src/worker.ts do not pass through here.
#
# connect-src names wss://laughtable.com alongside 'self' on purpose. Chrome treats 'self' as
# covering a same-origin WebSocket (verified here with a full three-client round), but that reading
# has not always held in every browser, and a blocked socket would break online play silently. Keep
# this host in step with lib/site.ts if the domain ever changes. Local dev relies on 'self'.
#
# script-src and style-src allow 'unsafe-inline' because a Next.js static export has no server to
# issue a per-request nonce and inlines its own hydration payload on every page. The value is still
# real: an injected <script src="…"> pointing anywhere but this origin is blocked, which is the
# shape an XSS would most likely take, and it is what keeps a premium token in localStorage from
# being posted to somebody else's host.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://laughtable.com; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
