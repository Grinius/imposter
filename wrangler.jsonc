{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imposter-game",
  "compatibility_date": "2026-09-08",
  "main": "src/worker.ts",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ImposterRoom" }, { "name": "RATE_LIMITER", "class_name": "RateLimiter" }, { "name": "REDEMPTIONS", "class_name": "RedemptionLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImposterRoom"] }, { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }, { "tag": "v3", "new_sqlite_classes": ["RedemptionLedger"] }],
  "assets": { "binding": "ASSETS", "directory": "./out", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" }
}
